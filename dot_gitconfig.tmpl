[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
  ; side-by-side = true
  line-numbers = true
  # colors from .chezmoidata/themes.toml ([roles.delta]); quoted, since # starts a comment
{{- $palette := (index .themes .theme).palette }}
{{- range $key, $spec := .roles.delta }}
  {{ $key }} = "{{ template "theme/spec" (dict "palette" $palette "spec" $spec) }}"
{{- end }}
[merge]
  conflictstyle = zdiff3
[diff]
  colorMoved = default
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[user]
	name = kerati
	email = enderwolf50@gmail.com
{{- if eq .chezmoi.os "windows" }}
[windows]
	appendAtomically = false
{{- end }}
