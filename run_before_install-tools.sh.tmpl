{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Install what .chezmoidata/tools.toml lists for Linux (`brew`, `cask`, `npm`, `go`) and this machine
# lacks. Runs before the files on every apply, so a failed install is retried and the first .zshrc
# finds its tools; with nothing missing it only looks the commands up. zsh comes from apt: a login
# shell has to be in /etc/shells.
brew=/home/linuxbrew/.linuxbrew/bin/brew

if ! command -v zsh >/dev/null; then
  echo 'install-tools: installing zsh (asks for the sudo password)'
  sudo apt-get update && sudo apt-get install -y zsh && chsh -s "$(command -v zsh)" ||
    echo 'install-tools: installing zsh failed' >&2
fi

if [ ! -x "$brew" ]; then
  echo 'install-tools: installing Homebrew (asks for the sudo password)'
  sudo apt-get install -y build-essential procps curl file git &&
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" ||
    { echo 'install-tools: installing Homebrew failed, tools skipped' >&2; exit 0; }
fi
eval "$("$brew" shellenv)"
# Same PNPM_HOME as .zshrc, so the npm tools below are found, and pnpm (a brew formula) agrees to
# a global add: it refuses one whose bin directory is not on PATH.
export PNPM_HOME="$HOME/.local/share/pnpm"
PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"

formulas=
casks=
npms=
gos=
new=
{{- range $tool := .tools }}
{{- if and (ne (index $tool "os" | default "") "windows") (or (hasKey $tool "brew") (hasKey $tool "cask") (hasKey $tool "npm") (hasKey $tool "go")) (or (not (hasKey $tool "lang")) (not (hasKey $ "languages")) (has $tool.lang $.languages)) (or (not (index $tool "personal" | default false)) (and (hasKey $ "personal") $.personal)) }}
{{- if hasKey $tool "brew" }}
command -v {{ $tool.check }} >/dev/null || { formulas="$formulas {{ $tool.brew }}"; new="$new {{ $tool.check }}"; }
{{- else if hasKey $tool "cask" }}
command -v {{ $tool.check }} >/dev/null || { casks="$casks {{ $tool.cask }}"; new="$new {{ $tool.check }}"; }
{{- else if hasKey $tool "npm" }}
command -v {{ $tool.check }} >/dev/null || { npms="$npms {{ $tool.npm }}"; new="$new {{ $tool.check }}"; }
{{- else }}
command -v {{ $tool.check }} >/dev/null || { gos="$gos {{ $tool.go }}"; new="$new {{ $tool.check }}"; }
{{- end }}
{{- end }}
{{- end }}
if [ -n "$formulas" ]; then
  echo "install-tools: brew install$formulas"
  brew install $formulas || echo 'install-tools: brew install failed' >&2
fi
if [ -n "$casks" ]; then
  echo "install-tools: brew install --cask$casks"
  brew install --cask $casks || echo 'install-tools: brew install --cask failed' >&2
fi
if [ -n "$npms" ]; then
  echo "install-tools: pnpm add -g$npms"
  pnpm add -g $npms || echo 'install-tools: pnpm add -g failed' >&2
fi
# Go comes from mise, whose shims may not be on PATH yet. Into ~/.local/bin, as on Windows: mise's
# GOBIN changes with each Go.
go=$(command -v go || echo "$HOME/.local/share/mise/shims/go")
if [ -n "$gos" ] && [ ! -x "$go" ]; then
  echo "install-tools: no go yet, skipped go install$gos; the next apply after mise installs Go picks them up"
elif [ -n "$gos" ]; then
  for m in $gos; do
    echo "install-tools: go install $m@latest"
    GOBIN="$HOME/.local/bin" "$go" install "$m@latest" || echo "install-tools: go install $m failed" >&2
  done
fi

# Print what the tools installed just now still need once (`after` in tools.toml), skipping any
# install that failed.
[ -z "$new" ] && exit 0
steps=
{{- range $tool := .tools }}
{{- if hasKey $tool "after" }}
case "$new " in *" {{ $tool.check }} "*) command -v {{ $tool.check }} >/dev/null && steps="$steps
  {{ $tool.after }}" ;; esac
{{- end }}
{{- end }}
[ -n "$steps" ] && echo "install-tools: to do once for what was just installed:$steps"
echo 'install-tools: open a new terminal (or run exec zsh) to pick up the new commands'
exit 0
{{ end -}}
