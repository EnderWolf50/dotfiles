# enved's settings. Written by chezmoi: the [theme] comes from .chezmoidata/themes.toml
# ([roles.enved]) so it follows the theme; change colors there, then run `chezmoi apply`.
# Other settings go above [theme]; `enved --default-config` lists them all.

[theme]
{{- $palette := (index .themes .theme).palette }}
{{- range $key, $spec := .roles.enved }}
{{ $key }} = "{{ template "theme/spec" (dict "palette" $palette "spec" $spec) }}"
{{- end }}
