{{- /* Colors are generated from .chezmoidata/themes.toml ([roles.lazygit]). */ -}}
{{- $palette := (index .themes .theme).palette -}}
gui:
  theme:
{{- range $key, $spec := .roles.lazygit }}
    {{ $key }}:
{{- range splitList " " $spec }}
      - "{{ index $palette . | default . }}"
{{- end }}
{{- end }}
git:
  diffRenderers:
    - type: stdinFilter
      colorArg: always
      command: delta --dark --paging=never
