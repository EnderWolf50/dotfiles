onboarding = false

[keys]
prefix = "ctrl+a"
detach = "prefix+d"
# workspace
workspace_picker = "prefix+w"
switch_workspace = "alt+1..9"
navigate_workspace_up = "k"
navigate_workspace_down = "j"
# tab
close_tab = "prefix+&"
# pane
split_vertical = "prefix+|"
split_horizontal = "prefix+-"
last_pane = "ctrl+\\"
focus_pane_left = ["prefix+h", "prefix+ctrl+h"]
focus_pane_right = ["prefix+l", "prefix+ctrl+l"]
focus_pane_up = ["prefix+k", "prefix+ctrl+k"]
focus_pane_down = ["prefix+j", "prefix+ctrl+j"]

[ui.toast]
delivery = "terminal"

[experimental]
pane_history = true
switch_ascii_input_source_in_prefix = true

[ui]
copy_on_select = false
host_cursor = "drawn"

status_indicators = "symbols"
[ui.sidebar.spaces]
rows = [
  ["$idx", "state_icon", "workspace"],
  ["branch", "git_status"],
]

[ui.sidebar.agents]
rows = [
  ["$idx", "state_icon", "machine", "workspace", "tab"],
  ["agent"],
]

[theme]
{{- /* From .chezmoidata/themes.toml: herdr's built-in theme when the theme names one, else
       the palette through [theme.custom]. */}}
{{- $theme := index .themes .theme }}
{{- $palette := $theme.palette }}
{{- if hasKey $theme "herdr" }}
name = "{{ $theme.herdr }}"
auto_switch = false
{{- else }}
name = "catppuccin"
auto_switch = false

[theme.custom]
{{- range $token, $spec := .roles.herdr }}
{{ $token }} = "{{ template "theme/spec" (dict "palette" $palette "spec" $spec) }}"
{{- end }}
{{- end }}

[ui.sound]
enabled = true
