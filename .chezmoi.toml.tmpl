{{- /* chezmoi's own config (~/.config/chezmoi/chezmoi.toml), generated by `chezmoi init`.
       Questions are asked once per machine; rerun `chezmoi init` after editing this file. */ -}}
{{- $preset := promptChoiceOnce . "prompt.preset" "Prompt symbols (ascii if the font lacks ❯ ⇡ ✘)" (list "unicode" "ascii") "unicode" -}}
{{- $personal := promptBoolOnce . "personal" "Personal development machine (installs personal tools and skills, including Railway CLI and Dalamud skills)" false -}}

[data]
    personal = {{ $personal }}

[data.prompt]
    preset = {{ $preset | quote }}

[diff]
    pager = ""

[git]
    autoCommit = false
    autoPush = false

{{ if eq .chezmoi.os "windows" -}}
[edit]
    command = "code"
    args = ["--wait"]

# `chezmoi merge`: VS Code's 3-way merge. chezmoi has no common base, so the rendered target
# doubles as one; the result is written to the source.
[merge]
    command = "pwsh"
    args = ["-NoProfile", "-Command", "Copy-Item -LiteralPath '{{ "{{ .Target }}" }}' '{{ "{{ .Target }}" }}.base'; code --new-window --wait --merge '{{ "{{ .Destination }}" }}' '{{ "{{ .Target }}" }}' '{{ "{{ .Target }}" }}.base' '{{ "{{ .Source }}" }}'"]
{{- else -}}
[edit]
    command = "nvim"

[merge]
    command = "nvim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]
{{- end }}
