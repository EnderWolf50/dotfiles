# tmux-256color (not screen-256color) so italics and other attributes work inside tmux
set -g default-terminal "tmux-256color"
set-option -ga terminal-overrides ",*256col*:Tc"

# FIX FOR WSL ONLY
set -sg escape-time 50

# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# split panes using | and -
unbind '%'
unbind '"'
bind | split-window -h
bind - split-window -v

# enable vi mode
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line
# y copies to the system clipboard through tmux-yank (it picks xclip, wl-copy or clip.exe)

# enable mouse mode (tmux 2.1 and above)
set -g mouse on

# easier and faster switching between next/prev window
bind-key C-p previous-window
bind-key C-n next-window

# start windows and panes index at 1 instead of 0
set -g base-index 1
setw -g pane-base-index 1

# ensure window index numbers get reordered on delete
set-option -g renumber-windows on

# tmux-sessionizer
if-shell -b 'type tmux-sessionizer >/dev/null' {
  bind-key -r f run-shell "tmux neww tmux-sessionizer"
}

# tpm and tmux plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'christoomey/vim-tmux-navigator'

run '~/.tmux/plugins/tpm/tpm'

# colors, from .chezmoidata/themes.toml (theme: {{ .theme }}); set after tpm so no plugin
# overrides them
{{- $p := (index .themes .theme).palette }}
set -g status-style "bg={{ $p.bg }},fg={{ $p.subtle }}"
set -g window-status-style "fg={{ $p.muted }}"
set -g window-status-current-style "fg={{ $p.accent }},bold"
set -g pane-border-style "fg={{ $p.faint }}"
set -g pane-active-border-style "fg={{ $p.accent }}"
set -g message-style "bg={{ $p.selection }},fg={{ $p.fg }}"
set -g mode-style "bg={{ $p.accent }},fg={{ $p.bg }}"
