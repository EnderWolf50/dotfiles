{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code writes ~/.claude/settings.json itself (permissions, plugins, autoMode, ...), so this repo
       touches only what .chezmoidata/claude.toml lists, plus theme and statusLine, and keeps everything else:
         set    top-level keys, written on every apply
         merge  keys inside an object, written on every apply; the object's other keys are kept
         seed   keys inside an object, written only when the machine has no value for them yet
         append list entries inside an object, added when missing; the machine's own entries are kept
         lsp    enabledPlugins for each language's LSP plugin: on for the languages in this machine's
                `languages` (chezmoi init), off for the rest; untouched where `languages` is unset */ -}}
{{- $s := dict -}}
{{- if .chezmoi.stdin }}{{ $s = .chezmoi.stdin | fromJson }}{{ end -}}
{{- range $key, $value := .claude.set }}{{ $_ := set $s $key $value }}{{ end -}}
{{- range $obj, $entries := .claude.merge -}}
{{-   $o := dict -}}
{{-   if hasKey $s $obj }}{{ $o = index $s $obj }}{{ end -}}
{{-   range $key, $value := $entries }}{{ $_ := set $o $key $value }}{{ end -}}
{{-   $_ := set $s $obj $o -}}
{{- end -}}
{{- range $obj, $entries := .claude.seed -}}
{{-   $o := dict -}}
{{-   if hasKey $s $obj }}{{ $o = index $s $obj }}{{ end -}}
{{-   range $key, $value := $entries }}{{ if not (hasKey $o $key) }}{{ $_ := set $o $key $value }}{{ end }}{{ end -}}
{{-   $_ := set $s $obj $o -}}
{{- end -}}
{{- range $obj, $entries := .claude.append -}}
{{-   $o := dict -}}
{{-   if hasKey $s $obj }}{{ $o = index $s $obj }}{{ end -}}
{{-   range $key, $values := $entries -}}
{{-     $l := list -}}
{{-     if hasKey $o $key }}{{ $l = index $o $key }}{{ end -}}
{{-     range $v := $values }}{{ if not (has $v $l) }}{{ $l = append $l $v }}{{ end }}{{ end -}}
{{-     $_ := set $o $key $l -}}
{{-   end -}}
{{-   $_ := set $s $obj $o -}}
{{- end -}}
{{- /* Shared plugin catalog: seed enablement and register the CC marketplace shape. */ -}}
{{- $plugins := dict -}}
{{- if hasKey $s "enabledPlugins" }}{{ $plugins = index $s "enabledPlugins" }}{{ end -}}
{{- range .agent_plugins.plugins }}{{ if and (has "claude" .hosts) (not (hasKey $plugins .id)) }}{{ $_ := set $plugins .id true }}{{ end }}{{ end -}}
{{- $_ := set $s "enabledPlugins" $plugins -}}
{{- $markets := dict -}}
{{- if hasKey $s "extraKnownMarketplaces" }}{{ $markets = index $s "extraKnownMarketplaces" }}{{ end -}}
{{- range $name, $entry := .agent_plugins.marketplaces -}}
{{- if has "claude" $entry.hosts -}}
{{- $source := dict "source" "github" "repo" $entry.source -}}
{{- if hasKey $entry "claude_sparse" }}{{ $_ := set $source "sparsePaths" $entry.claude_sparse }}{{ end -}}
{{- $market := dict "source" $source -}}
{{- if hasKey $entry "auto_update" }}{{ $_ := set $market "autoUpdate" $entry.auto_update }}{{ end -}}
{{- $_ := set $markets $name $market -}}
{{- end }}{{ end -}}
{{- $_ := set $s "extraKnownMarketplaces" $markets -}}
{{- if hasKey . "languages" -}}
{{-   $p := dict -}}
{{-   if hasKey $s "enabledPlugins" }}{{ $p = index $s "enabledPlugins" }}{{ end -}}
{{-   range $lang, $id := .claude.lsp }}{{ $_ := set $p $id (has $lang $.languages) }}{{ end -}}
{{-   $_ := set $s "enabledPlugins" $p -}}
{{- end -}}
{{- $_ := set (index $s "env") "RIPGREP_CONFIG_PATH" (joinPath .chezmoi.homeDir ".config" "ripgrep" "config") -}}
{{- $_ := set $s "theme" (printf "custom:%s" .theme) -}}
{{- $_ := set $s "statusLine" (dict "type" "command" "command" "bun ~/.claude/statusline/statusline.js" "padding" 0 "refreshInterval" 2) -}}
{{ $s | toPrettyJson }}
