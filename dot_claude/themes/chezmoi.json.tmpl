{{- /* Generated from .chezmoidata/themes.toml ([roles.claude]). Edit the theme there, not this file. */ -}}
{{- $palette := (index .themes .theme).palette -}}
{
  "name": "{{ .theme | title }}",
  "base": "dark",
  "overrides": {
{{- $sep := "" }}
{{- range $token, $spec := .roles.claude }}{{ $sep }}
    "{{ $token }}": "{{ template "theme/spec" (dict "palette" $palette "spec" $spec) }}"
{{- $sep = "," }}
{{- end }}
  }
}
